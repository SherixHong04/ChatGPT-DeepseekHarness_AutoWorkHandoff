<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Work Handoff · 转交前选择" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource Bg}" FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" CornerRadius="12" GlassFrameThickness="0"
                        ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#171B24"/>
    <SolidColorBrush x:Key="Surface" Color="#202632"/>
    <SolidColorBrush x:Key="Line" Color="#343D4D"/>
    <SolidColorBrush x:Key="Text" Color="#F1F5FC"/>
    <SolidColorBrush x:Key="Muted" Color="#ADB9CC"/>
    <SolidColorBrush x:Key="Accent" Color="#91B8FF"/>
    <SolidColorBrush x:Key="Track" Color="#303D55"/>
    <SolidColorBrush x:Key="Hover" Color="#2C3544"/>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Plate" CornerRadius="7" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.62"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Plate" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Card" CornerRadius="12" Background="{DynamicResource Bg}"
          BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="18"
          RenderOptions.ClearTypeHint="Enabled">
    <StackPanel>
      <Grid Height="34">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
        <Border Width="30" Height="30" HorizontalAlignment="Left" CornerRadius="8" Background="{DynamicResource Surface}">
          <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Data="M 0,5 H 18 M 14,1 L 18,5 L 14,9 M 18,15 H 0 M 4,11 L 0,15 L 4,19"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="转交当前工作？" Foreground="{DynamicResource Text}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="WORK HANDOFF" Foreground="{DynamicResource Muted}" FontFamily="Segoe UI" FontSize="9" Margin="0,1,0,0"/>
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="2" Width="24" Height="24" VerticalAlignment="Top"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Focusable="True" TabIndex="2"
                AutomationProperties.Name="关闭并暂不转交" ToolTip="关闭并暂不转交"
                Foreground="{DynamicResource Muted}" Background="Transparent" BorderThickness="0" Cursor="Hand">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ClosePlate" Background="Transparent" CornerRadius="5"><Path Width="9" Height="9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Data="M 0,0 L 9,9 M 9,0 L 0,9"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ClosePlate" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ClosePlate" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="ClosePlate" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        </Button>
      </Grid>
      <TextBlock Text="额度已达预留线，可交给 Harness 继续。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,13,0,0"/>
      <Border Background="{DynamicResource Surface}" CornerRadius="7" Padding="10,9" Margin="0,10,0,0">
        <TextBlock x:Name="TaskTitle" Text="当前任务" Foreground="{DynamicResource Text}" FontSize="13"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="19" MaxHeight="38"/>
      </Border>
      <Grid Margin="0,13,0,0">
        <TextBlock x:Name="Countdown" Text="30 秒后自动转交" Foreground="{DynamicResource Accent}" FontSize="12" AutomationProperties.Name="自动转交倒计时"/>
        <TextBlock Text="可随时取消" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
      </Grid>
      <ProgressBar x:Name="Remaining" Height="3" Margin="0,7,0,0" Minimum="0" Maximum="30000" Value="30000"
                   Background="{DynamicResource Track}" Foreground="{DynamicResource Accent}" BorderThickness="0" Focusable="False">
        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1.5"/></Grid></ControlTemplate></ProgressBar.Template>
      </ProgressBar>
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="NoButton" Style="{StaticResource ActionButton}" Content="暂不转交" TabIndex="0" AutomationProperties.Name="暂不转交"/>
        <Button x:Name="YesButton" Grid.Column="2" Style="{StaticResource ActionButton}" Content="立即转交" TabIndex="1"
                Background="#2563D9" Foreground="White" BorderBrush="#3978E9" AutomationProperties.Name="立即转交"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
