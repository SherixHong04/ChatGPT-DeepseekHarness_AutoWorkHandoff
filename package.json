{
  "name": "work-handoff",
  "version": "0.3.0-beta.4",
  "private": true,
  "type": "module",
  "description": "Portable Windows preview: native quota hooks, durable handoff and same-chat Harness execution",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc && node scripts/build-plugin.mjs",
    "pretest:local": "npm run build",
    "test:local": "node --test dist/tests/*.test.js",
    "predemo": "npm run build",
    "demo": "node dist/src/cli.js demo",
    "prefile-demo": "npm run build",
    "file-demo": "node dist/src/cli.js file-demo",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "wake": "node scripts/wake.mjs",
    "verify:release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "files": [
    "src/",
    "dist/",
    "scripts/",
    "skills/",
    "plugins/",
    "config/",
    "docs/",
    "examples/",
    "README.md",
    "THIRD-PARTY-LICENSES.txt",
    "tsconfig.json",
    "verification/RESULTS.md",
    "verification/install-check.json",
    "verification/LOCAL-WAKE.md"
  ],
  "license": "UNLICENSED"
}
